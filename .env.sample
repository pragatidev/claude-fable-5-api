# Copy this file to .env in THIS folder (the repo root).
#   Windows:  copy .env.sample .env
#   macOS / Linux:  cp .env.sample .env
#
# Then replace the value below with a key from:
#   https://platform.claude.com/settings/keys
#
# Never commit .env. Git ignores it. Live labs read this file only.

ANTHROPIC_API_KEY=sk-ant-your-key-here
